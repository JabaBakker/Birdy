# Verplicht
ANTHROPIC_API_KEY=sk-ant-...

# ── Kanaal ──────────────────────────────────────────────────────────────────

# Slack (Socket Mode — geen open poorten). Zie README "Slack koppelen".
SLACK_BOT_TOKEN=          # xoxb-... (Install to Workspace)
SLACK_APP_TOKEN=          # xapp-... (Socket Mode, scope connections:write)
# Member-ids die de bot bedient (komma-gescheiden). Laat leeg bij eerste start:
# stuur de bot een DM, hij antwoordt met je member-id, vul in, herstart.
SLACK_ALLOWED_MEMBER_IDS=
# Kanaal-ids (rechtermuisklik op kanaal → View channel details → onderaan):
SLACK_CHANNEL_BIRDY=      # conversatiekanaal #birdy
SLACK_CHANNEL_BRIEFING=   # leeskanaal #briefing (briefings landen hier)

# ── Naam en vaste momenten ──────────────────────────────────────────────────

AGENT_NAME=Birdy

# Vaste momenten (lokale NL-tijd). Leeg = uit.
# Ochtendbriefing in de chat, bijv. 07:15 (het gezin van Jaap heeft hem uit: het
# dashboard toont alles al; Birdy's aandachtspunten komen dan uit de weekplanning).
AGENT_DIGEST_TIME=
AGENT_WEEKLY_TIME=SUN 19:30
# Stil ochtendmoment: Birdy werkt alleen haar aandachtspunten voor het dashboard bij,
# zonder chatbericht. Leeg = uit.
AGENT_AANDACHT_TIME=07:15
# Eigen-initiatief-moment (Birdy zoekt zelf één ding uit). Leeg = uit; uitzoekwerk vraag
# je liever in de chat ("zoek eens uit …"). Bijv. 13:00 om het aan te zetten.
AGENT_PROACTIVE_TIME=

# Budget-guardrails (USD)
AGENT_DAILY_BUDGET_USD=3
AGENT_CYCLE_BUDGET_USD=1

# Model en turn-limiet
AGENT_MODEL=sonnet
AGENT_MAX_TURNS=20

# ── Google (Calendar + Drive) ───────────────────────────────────────────────

# OAuth als Jaap — eenmalig verkrijgen via scripts/google_consent.py (op je laptop):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Agenda-ID uit de instellingen van de gedeelde agenda:
GOOGLE_CALENDAR_ID=

# Documentenhub: map-id van de gedeelde Drive-map "Birdy 2.0"
# (het deel achter /folders/ in de URL). Leeg = Drive uit.
DRIVE_ROOT_FOLDER_ID=
# Hoe vaak de map "00 Inbox" gecheckt wordt op nieuwe bestanden (minuten, 0 = uit):
AGENT_DRIVE_INBOX_POLL_MIN=5

# Oud (terugval tijdens de overgang; verwijderen zodra OAuth werkt):
GOOGLE_SERVICE_ACCOUNT_FILE=/data/workspace/secrets/service-account.json

# FamilyWall iCal-leeslink (optioneel): FamilyWall-app -> Calendar -> instellingen ->
# "Generate iCal and copy the link". Birdy leest deze afspraken mee (alleen-lezen).
FAMILYWALL_ICS_URL=

# Extra alleen-lezen agendafeeds (iCal), gescheiden door ; en elk als "Label|url".
# Bijv. een sportprogramma (Nevobo, KNVB, Sportlink) of een schoolkalender. Zet een
# gezinsnaam in het label ("Volleybal Yvette") en het dashboard kleurt die afspraken
# als van die persoon.
AGENDA_ICS_FEEDS=

# iCal-feeds die Birdy ín de Google-gezinsagenda zet en actueel houdt (zelfde formaat).
# Gebruik dit voor sportprogramma's die je in Google Agenda zelf wilt zien; Birdy maakt
# de afspraken aan, werkt ze bij als de bond iets verschuift en verwijdert afgelastingen.
# Niet dezelfde feed ook in AGENDA_ICS_FEEDS zetten (dubbel).
AGENDA_SYNC_ICS=
# Hoe vaak synchroniseren (uren, 0 = uit); ook los te draaien: gcal.py sync-ics
AGENT_ICS_SYNC_HOURS=6

# ── Dashboard (muurtablet) ──────────────────────────────────────────────────

# Zelfgekozen sleutel; leeg = dashboard uit. Openen: https://<vps>.ts.net/?key=<sleutel>
DASHBOARD_TOKEN=
DASHBOARD_PORT=8811

# ── Homey Pro (🏠-blokje op het dashboard; optioneel) ───────────────────────

# Homey-ID: app → Instellingen → Algemeen → Cloud. API-key: my.homey.app →
# Instellingen → API-keys (scopes: Apparaten lezen [+ bedienen], Flows lezen).
HOMEY_ID=
HOMEY_API_KEY=

# ── Todoist (boodschappen- en actielijst) ───────────────────────────────────

# Settings → Integrations → Developer → API token:
TODOIST_API_TOKEN=

# ── Gezin (voor de prompts en het dashboard) ────────────────────────────────

# Gezinsleden voor kleuren en filters op het dashboard (komma-gescheiden):
DASHBOARD_PERSONEN=
# De ouders, zoals de assistent ze noemt ("Jaap en Yvette"):
AGENT_OUDERS=
# Wie een taak krijgt als de eigenaar onduidelijk is:
AGENT_VANGNET=
# Het Google-account waarmee de assistent zelf in de agenda schrijft (toont "Birdy" als maker):
AGENT_GOOGLE_ACCOUNT=

# ── Geld (financiële module 3.0) ────────────────────────────────────────────

# Pincode voor de Geld-tab op het dashboard (4-8 cijfers, per apparaat één keer gevraagd).
# Leeg = tab verborgen. Het register is de Google Sheet "30 Financiën/Financieel overzicht"
# (aanmaken: python /app/agent/financien.py maak).
DASHBOARD_GELD_PIN=
# Verrekenen werkt tegenover de gezamenlijke pot (zie financien.py); losse verrekenposten
# staan in workspace/memory/verrekenen.json en worden via de Geld-tab toegevoegd/afgerekend.
