# Verplicht
ANTHROPIC_API_KEY=sk-ant-...

# ── Kanalen (minstens één) ──────────────────────────────────────────────────

# Slack (aanbevolen, Socket Mode — geen open poorten). Zie README "Slack koppelen".
SLACK_BOT_TOKEN=          # xoxb-... (Install to Workspace)
SLACK_APP_TOKEN=          # xapp-... (Socket Mode, scope connections:write)
# Member-ids die de bot bedient (komma-gescheiden). Laat leeg bij eerste start:
# stuur de bot een DM, hij antwoordt met je member-id, vul in, herstart.
SLACK_ALLOWED_MEMBER_IDS=
# Kanaal-ids (rechtermuisklik op kanaal → View channel details → onderaan):
SLACK_CHANNEL_BIRDY=      # conversatiekanaal #birdy
SLACK_CHANNEL_BRIEFING=   # leeskanaal #briefing (briefings landen hier)

# Telegram (1.0 — vervalt na de overgang naar Slack)
TELEGRAM_BOT_TOKEN=       # via @BotFather in Telegram
TELEGRAM_ALLOWED_CHAT_IDS=

# ── Naam en vaste momenten ──────────────────────────────────────────────────

AGENT_NAME=Birdy

# Vaste momenten (lokale NL-tijd). Leeg = uit.
# Ochtendbriefing in de chat, bijv. 07:15 (het gezin van Jaap heeft hem uit: het
# dashboard toont alles al; Birdy's aandachtspunten komen dan uit de weekplanning).
AGENT_DIGEST_TIME=
AGENT_WEEKLY_TIME=SUN 19:30
# Eigen-initiatief-moment (Birdy zoekt zelf één ding uit). Leeg = uit; uitzoekwerk vraag
# je liever in de chat ("zoek eens uit …"). Bijv. 13:00 om het aan te zetten.
AGENT_PROACTIVE_TIME=

# Budget-guardrails (USD)
AGENT_DAILY_BUDGET_USD=3
AGENT_CYCLE_BUDGET_USD=1

# Model en turn-limiet
AGENT_MODEL=sonnet
AGENT_MAX_TURNS=20

# ── Google (Calendar + Drive) ───────────────────────────────────────────────

# OAuth als Jaap — eenmalig verkrijgen via scripts/google_consent.py (op je laptop):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Agenda-ID uit de instellingen van de gedeelde agenda:
GOOGLE_CALENDAR_ID=

# Documentenhub: map-id van de gedeelde Drive-map "Birdy 2.0"
# (het deel achter /folders/ in de URL). Leeg = Drive uit.
DRIVE_ROOT_FOLDER_ID=
# Hoe vaak de map "00 Inbox" gecheckt wordt op nieuwe bestanden (minuten, 0 = uit):
AGENT_DRIVE_INBOX_POLL_MIN=5

# Oud (terugval tijdens de overgang; verwijderen zodra OAuth werkt):
GOOGLE_SERVICE_ACCOUNT_FILE=/data/workspace/secrets/service-account.json

# FamilyWall iCal-leeslink (optioneel): FamilyWall-app -> Calendar -> instellingen ->
# "Generate iCal and copy the link". Birdy leest deze afspraken mee (alleen-lezen).
FAMILYWALL_ICS_URL=

# ── Dashboard (muurtablet) ──────────────────────────────────────────────────

# Zelfgekozen sleutel; leeg = dashboard uit. Openen: https://<vps>.ts.net/?key=<sleutel>
DASHBOARD_TOKEN=
DASHBOARD_PORT=8811

# ── Homey Pro (🏠-blokje op het dashboard; optioneel) ───────────────────────

# Homey-ID: app → Instellingen → Algemeen → Cloud. API-key: my.homey.app →
# Instellingen → API-keys (scopes: Apparaten lezen [+ bedienen], Flows lezen).
HOMEY_ID=
HOMEY_API_KEY=

# ── Todoist (boodschappen- en actielijst) ───────────────────────────────────

# Settings → Integrations → Developer → API token:
TODOIST_API_TOKEN=
