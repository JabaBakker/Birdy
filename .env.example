# Verplicht
ANTHROPIC_API_KEY=sk-ant-...
TELEGRAM_BOT_TOKEN=123456:ABC...   # via @BotFather in Telegram

# Chat-ids die de bot bedient (komma-gescheiden). Laat leeg bij eerste start:
# stuur daarna /start naar de bot, hij antwoordt met het chat-id, vul het hier in, herstart.
TELEGRAM_ALLOWED_CHAT_IDS=

# Naam van de assistent in de chat
AGENT_NAME=Fien

# Vaste momenten (lokale NL-tijd)
AGENT_DIGEST_TIME=07:15
AGENT_WEEKLY_TIME=SUN 19:30
AGENT_PROACTIVE_TIME=13:00

# Budget-guardrails (USD)
AGENT_DAILY_BUDGET_USD=3
AGENT_CYCLE_BUDGET_USD=1

# Model en turn-limiet
AGENT_MODEL=sonnet
AGENT_MAX_TURNS=20

# Google Calendar (optioneel — zie README, stap "Agenda koppelen")
# Agenda-ID uit de instellingen van de gedeelde agenda:
GOOGLE_CALENDAR_ID=
# Sleutelbestand van het service-account (standaardpad, meestal niet aanpassen):
GOOGLE_SERVICE_ACCOUNT_FILE=/data/workspace/secrets/service-account.json

# FamilyWall iCal-leeslink (optioneel): FamilyWall-app -> Calendar -> instellingen ->
# "Generate iCal and copy the link". Birdy leest deze afspraken mee (alleen-lezen).
FAMILYWALL_ICS_URL=
